rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users/{uid}
    // Document ID: Firebase Auth UID
    // Fields:
    //   - handle: string, 3-20 chars, regex '^[A-Za-z0-9_]{3,20}$' (required)
    //   - avatar: string, max 10 chars (optional)
    //   - createdAt: timestamp (required, immutable)
    //   - updatedAt: timestamp (optional)
    //
    // Subcollection: users/{uid}/leagueMemberships/{code}
    // Document ID: 8-char league code
    // Access: Owner only (read/write)
    //
    // Subcollection: users/{uid}/diary/{betId}
    // Document ID: Bet entry ID
    // Access: Owner only (read/write)
    //
    // Collection: handles/{handleLower}
    // Document ID: Canonical lowercase handle
    // Fields:
    //   - uid: string, auth UID (required, immutable)
    //   - handle: string, original case, regex '^[A-Za-z0-9_]{3,20}$' (required, immutable)
    //   - createdAt: timestamp (required, immutable)
    // Access: Public read (availability checks), authenticated create/delete by owner
    //
    // Collection: leagues/{code}
    // Document ID: 8-char code '^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{8}$'
    // Fields:
    //   - name: string, 1-64 chars, no < > & " (required)
    //   - icon: string, 1-10 chars, no < > & " (required)
    //   - freq: string, 'weekly' | 'monthly' | 'yearly' (required)
    //   - code: string, matches doc ID (required, immutable)
    //   - creatorUid: string (required, immutable)
    //   - creatorHandle: string (optional)
    //   - createdAt: timestamp or ISO string (required, immutable)
    //   - updatedAt: timestamp or ISO string (optional)
    //   - memberCount: int, >= 0 (optional)
    // Access: Verified user (Google, or email/password with email_verified) get; list only for the app owner. Creator create/update/delete.
    //
    // Subcollection: leagues/{code}/members/{uid}
    // Document ID: Firebase Auth UID
    // Fields:
    //   - handle: string, 3-20 chars (required)
    //   - avatar: string, max 10 chars (required)
    //   - joinedAt: timestamp or string (required on create, immutable)
    //   - handle must be registered to this uid in handles/{handleLower}
    //   - points, winRate, roi, settled, form, periods, scoredAt: written only by the server
    //   - updatedAt: timestamp or string (required)
    // Access: Verified user (Google, or email/password with email_verified) read. Member create (league must exist,
    //   member not banned) and update (league must exist). Member leave OR Creator kick on delete.
    //
    // Subcollection: leagues/{code}/banned/{uid}
    // Fields: handle (optional), bannedAt (required)
    // Access: Creator create/delete/read; the banned player may read their own entry.
    //
    // Subcollection: users/{uid}/leagueBets/{day}   (day = match date YYYY-MM-DD)
    // Fields from the app: betId, fixtureId, selection, odds (optional), market (optional), legs (accumulators only),
    //   createdAt (== request.time)
    // Fields from the server: status, reason, market, refOdds, kickoffAt, outcome, points, ...
    // Access: owner read; owner create once; delete only before kick-off or after a refusal.
    //
    // Collection: leagueStats/{uid}   (server only: the player's week/month/season stats)
    // Collection: ladders/{period}__{tier}   (server only: top 50 per regional ladder)
    // Access: Verified Google users read; no client writes.
    //
    // Collection: geo_leagues/{tierId}
    // Document ID: Geographic tier ID ('geo-world', etc.)
    // Access: Public read, client write disabled (server managed).
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Google accounts, or email/password accounts whose address has been confirmed.
    function isVerifiedUser() {
      return isAuthenticated() &&
        'firebase' in request.auth.token &&
        (request.auth.token.firebase.get('sign_in_provider', '') == 'google.com' ||
         (request.auth.token.firebase.get('sign_in_provider', '') == 'password' &&
          request.auth.token.get('email_verified', false) == true));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // App owner (founder telemetry dashboard). Mirrors OWNER_EMAILS in app.js.
    function isAppOwner() {
      return isAuthenticated() &&
        request.auth.token.get('email_verified', false) == true &&
        request.auth.token.get('email', '').lower() in ['headpark@gmail.com'];
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return data.keys().hasOnly(['handle', 'avatar', 'createdAt', 'updatedAt', 'town', 'region', 'country']) &&
        data.keys().hasAll(['handle', 'createdAt']) &&
        data.handle is string &&
        data.handle.matches('^[A-Za-z0-9_]{3,20}$') &&
        (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 10)) &&
        // Legacy profiles stored createdAt as an ISO string; new ones use a server timestamp.
        (data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 40)) &&
        (!('updatedAt' in data) || (data.updatedAt is timestamp)) &&
        (!('town' in data) || isPlace(data.town)) &&
        (!('region' in data) || isPlace(data.region)) &&
        (!('country' in data) || isPlace(data.country));
    }

    function isValidHandleDoc(data) {
      return data.keys().hasOnly(['uid', 'handle', 'createdAt']) &&
        data.keys().hasAll(['uid', 'handle', 'createdAt']) &&
        data.uid is string &&
        data.uid.size() <= 128 &&
        data.handle is string &&
        data.handle.matches('^[A-Za-z0-9_]{3,20}$') &&
        data.createdAt is timestamp;
    }

    // Text shown to other players may not contain HTML markup characters.
    function isSafeText(s, maxLen) {
      return s is string && s.size() >= 1 && s.size() <= maxLen && !s.matches('(?s).*[<>&"].*');
    }

    function isTimeValue(v) {
      return v is timestamp || (v is string && v.size() <= 40);
    }

    function isValidLeague(data) {
      return data.keys().hasOnly(['name', 'icon', 'freq', 'code', 'creatorUid', 'creatorHandle', 'createdAt', 'updatedAt', 'memberCount']) &&
        data.keys().hasAll(['name', 'icon', 'freq', 'code', 'creatorUid', 'createdAt']) &&
        isSafeText(data.name, 64) &&
        isSafeText(data.icon, 10) &&
        data.freq is string && data.freq in ['weekly', 'monthly', 'yearly'] &&
        data.code is string && data.code.matches('^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{8}$') &&
        data.creatorUid is string && data.creatorUid.size() <= 128 &&
        (!('creatorHandle' in data) || (data.creatorHandle is string && data.creatorHandle.matches('^[A-Za-z0-9_]{1,24}$'))) &&
        isTimeValue(data.createdAt) &&
        (!('updatedAt' in data) || isTimeValue(data.updatedAt)) &&
        (!('memberCount' in data) || (data.memberCount is int && data.memberCount >= 0));
    }

    // A member's gamertag must be one they hold in the handles registry, so nobody can appear
    // on a leaderboard under someone else's name.
    function ownsHandle(database, handle, uid) {
      return get(/databases/$(database)/documents/handles/$(handle.lower())).data.uid == uid;
    }

    // joinedAt is required when the record is created (see the create rule) and immutable after.
    // A legacy 'uid' field is tolerated only when it matches the document ID.
    // League stats are calculated by the server (Cloud Functions) from checked, settled league bets.
    // The app may never write these fields on a member record.
    function statFields() {
      return ['points', 'winRate', 'roi', 'settled', 'form', 'periods', 'scoredAt'];
    }

    // joinedAt is required when the record is created (see the create rule) and immutable after.
    // A legacy 'uid' field is tolerated only when it matches the document ID.
    function isValidMember(data, uid) {
      return data.keys().hasOnly(['uid', 'handle', 'avatar', 'joinedAt', 'updatedAt', 'points', 'winRate', 'roi', 'settled', 'form', 'periods', 'scoredAt']) &&
        data.keys().hasAll(['handle', 'avatar', 'updatedAt']) &&
        (!('uid' in data) || data.uid == uid) &&
        data.handle is string && data.handle.matches('^[A-Za-z0-9_]{3,20}$') &&
        data.avatar is string && data.avatar.size() <= 10 && !data.avatar.matches('(?s).*[<>&"].*') &&
        (!('joinedAt' in data) || isTimeValue(data.joinedAt)) &&
        isTimeValue(data.updatedAt);
    }

    // users/{uid}/leagueBets/{day}: one league bet per match day, stamped with the server's clock.
    // The server adds the checked fixture, market, bookmaker price and later the result.
    function isValidLeagueBet(data, day) {
      return day.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$') &&
        data.keys().hasOnly(['betId', 'fixtureId', 'selection', 'odds', 'legs', 'market', 'createdAt']) &&
        data.keys().hasAll(['betId', 'fixtureId', 'selection', 'createdAt']) &&
        data.betId is string && data.betId.size() >= 1 && data.betId.size() <= 64 &&
        data.fixtureId is string && data.fixtureId.size() >= 1 && data.fixtureId.size() <= 80 &&
        data.selection is string && data.selection.size() >= 1 && data.selection.size() <= 400 &&
        // Accumulators list each leg's match and pick; the server checks every leg.
        (!('legs' in data) || (data.legs is list && data.legs.size() >= 2 && data.legs.size() <= 10)) &&
        (!('odds' in data) || (data.odds is number && data.odds > 1 && data.odds < 10000)) &&
        // A market key such as btts:yes; the server only settles keys it knows.
        (!('market' in data) || (data.market is string && data.market.size() <= 24)) &&
        data.createdAt == request.time;
    }

    function isPlace(v) {
      return isSafeText(v, 40);
    }

    function isValidBan(data) {
      return data.keys().hasOnly(['handle', 'bannedAt']) &&
        data.keys().hasAll(['bannedAt']) &&
        (!('handle' in data) || (data.handle is string && data.handle.size() <= 20)) &&
        isTimeValue(data.bannedAt);
    }

    function leaguePath(database, code) {
      return /databases/$(database)/documents/leagues/$(code);
    }

    function isLeagueCreator(database, code) {
      return get(leaguePath(database, code)).data.creatorUid == request.auth.uid;
    }

    // ===============================================================
    // Collection Match Rules
    // ===============================================================

    // 1. User Profiles & Subcollections
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid) && isValidUser(request.resource.data);
      allow update: if isOwner(uid) && isValidUser(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      // 2. User League Memberships index
      match /leagueMemberships/{code} {
        allow read, write: if isOwner(uid);
      }

      // 3. User Cloud Diary entries
      match /diary/{betId} {
        allow read, write: if isOwner(uid);
      }

      // 3b. League bets: create only. A bet can be withdrawn before kick-off, or removed if the
      // server refused it; after kick-off it stands, so nobody can delete a losing bet.
      match /leagueBets/{day} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isVerifiedUser() && isValidLeagueBet(request.resource.data, day);
        allow update: if false;
        allow delete: if isOwner(uid) &&
          (resource.data.get('status', '') == 'rejected' ||
           (resource.data.get('status', '') == 'pending' &&
            resource.data.get('kickoffAt', null) is timestamp &&
            request.time < resource.data.kickoffAt));
      }
    }

    // 3c. Each player's league stats, calculated by the server. Read-only for players.
    match /leagueStats/{uid} {
      allow read: if isVerifiedUser();
      allow write: if false;
    }

    // 3d. Regional ladders (top 50 per period and tier), built by the server.
    match /ladders/{ladderId} {
      allow read: if isVerifiedUser();
      allow write: if false;
    }

    // 4. Global Handle Registry (doc ID = handleLower)
    match /handles/{handleLower} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        handleLower == request.resource.data.handle.lower() &&
        isValidHandleDoc(request.resource.data);
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // 5. Private Leagues
    match /leagues/{code} {
      allow get: if isVerifiedUser();
      allow list: if isAppOwner();

      allow create: if isVerifiedUser() &&
        request.resource.data.creatorUid == request.auth.uid &&
        request.resource.data.code == code &&
        isValidLeague(request.resource.data);

      allow update: if isVerifiedUser() &&
        resource.data.creatorUid == request.auth.uid &&
        request.resource.data.creatorUid == resource.data.creatorUid &&
        request.resource.data.code == resource.data.code &&
        request.resource.data.createdAt == resource.data.createdAt &&
        isValidLeague(request.resource.data);

      allow delete: if isVerifiedUser() &&
        (resource.data.creatorUid == request.auth.uid || isAppOwner());

      // 6. League Members Subcollection
      // Members can only join a league that exists (or is created in the same batch) and
      // that has not banned them. Stat refreshes are updates only, so a kicked player, a
      // player who left on another device, or a deleted league is never silently recreated.
      match /members/{uid} {
        allow read: if isVerifiedUser() || isAppOwner();

        allow create: if isVerifiedUser() &&
          request.auth.uid == uid &&
          existsAfter(leaguePath(database, code)) &&
          !exists(/databases/$(database)/documents/leagues/$(code)/banned/$(uid)) &&
          'joinedAt' in request.resource.data &&
          !request.resource.data.keys().hasAny(statFields()) &&
          isValidMember(request.resource.data, uid) &&
          ownsHandle(database, request.resource.data.handle, uid);

        allow update: if isVerifiedUser() &&
          request.auth.uid == uid &&
          exists(leaguePath(database, code)) &&
          request.resource.data.get('joinedAt', null) == resource.data.get('joinedAt', null) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(statFields()) &&
          isValidMember(request.resource.data, uid) &&
          ownsHandle(database, request.resource.data.handle, uid);

        allow delete: if isVerifiedUser() &&
          (request.auth.uid == uid || isLeagueCreator(database, code) || isAppOwner());
      }

      // 6b. Players the creator has thrown out; blocks them from re-joining with the code.
      match /banned/{uid} {
        allow read: if isVerifiedUser() &&
          (request.auth.uid == uid || isLeagueCreator(database, code));
        allow create: if isVerifiedUser() &&
          isLeagueCreator(database, code) &&
          uid != request.auth.uid &&
          isValidBan(request.resource.data);
        allow delete: if isVerifiedUser() && isLeagueCreator(database, code);
      }
    }

    // 7. Geographic Tier Leagues (Read only for clients; server-aggregated)
    match /geo_leagues/{tierId} {
      allow read: if true;
      allow write: if false;
    }

    // 8. Default Deny on all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
